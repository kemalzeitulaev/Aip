<!DOCTYPE html>
<html lang="ru">
 <head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1">
   <title><%= title === 'Porsche' ? 'Porsche' : title + ' — Porsche' %></title>
   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
   <link rel="stylesheet" href="/stylesheets/style.css">
 </head>
 <body>
   <nav class="navbar navbar-expand-lg navbar-dark porsche-nav">
     <div class="container-fluid">
       <a class="navbar-brand logo" href="/">Porsche</a>
       <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Меню">
         <span class="navbar-toggler-icon"></span>
       </button>
       <div class="collapse navbar-collapse" id="navbarSupportedContent">
         <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
           <li class="nav-item"><a class="nav-link" href="/">Главная</a></li>
           <% if (typeof nav == 'object' && nav) {
                nav.forEach(function(item) { %>
           <li class="nav-item">
             <a class="nav-link" href="/porsche/<%= item.nick %>"><%= item.title %></a>
           </li>
           <% })} %>
           <li class="nav-item"><a class="nav-link" href="https://kemalzeitulaev.github.io/Aip/">Весь сайт</a></li>
           <% if (user) { %>
             <li class="nav-item">
               <form action="/logout" method="post">
                 <button type="submit" class="nav-link">Выйти</button>
               </form>
             </li>
           <% } else { %>
             <li class="nav-item"><a class="nav-link" href="/logreg">Войти</a></li>
           <% } %>
         </ul>
       </div>
     </div>
   </nav>
   <%- body %>
   <footer class="site-footer">
     <a class="logo" href="/">Porsche</a>
     <p>There is no substitute.</p>
     <p class="copy">Учебный сервер по сайту Kemal Zeitulaev. Фото те же, что на полном сайте.</p>
   </footer>
   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
 </body>
</html>
