<% layout('./layout/page.ejs') %>

<article class="model">
  <div class="model-media">
    <img src="<%= picture %>" alt="<%= title %>">
  </div>
  <div class="model-copy">
    <p class="eyebrow"><%= eyebrow %></p>
    <h1><%= title %></h1>
    <p class="lead"><%= desc %></p>
    <a class="btn" href="<%= page %>">Открыть на сайте Porsche</a>
  </div>
</article>
